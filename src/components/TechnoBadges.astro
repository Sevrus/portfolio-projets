---
const techs = [
    "⚛️ React",
    "🟢 Node.js",
    "🐍 Python",
    "☕ Java",
    "🐘 PostgreSQL",
];
---
<div class="flex flex-wrap justify-center gap-2">
    {techs.map((tech) => (
            <span class="bg-gray-800 px-4 py-2 rounded-full text-sm border border-gray-700">
      {tech}
    </span>
    ))}
</div>
