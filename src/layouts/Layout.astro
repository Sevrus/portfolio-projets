---
import "../styles/global.css";

export interface Props {
    title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body class="bg-gray-900 text-white font-sans antialiased min-h-screen p-8">
<div class="max-w-4xl mx-auto">

    <!-- Navigation commune à toutes les pages -->
    <nav class="flex gap-6 mb-10 text-gray-400 font-medium border-b border-gray-800 pb-4">
        <a href="/" class="hover:text-blue-400 transition">🏠 Accueil</a>
        <a href="/projects" class="hover:text-blue-400 transition">📂 Projets</a>
    </nav>

    <slot />

</div>
</body>
</html>
