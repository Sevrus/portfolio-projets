---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import TechnoBadges from "../components/TechnoBadges.astro";
import SocialLinks from "../components/SocialLinks.astro";
---
<Layout title="Mon Portfolio - Développeur">
	<div class="flex flex-col items-center gap-y-8 py-10">

		<!-- Avatar -->
		<Avatar />

		<h1 class="text-5xl font-extrabold text-center">
			Bonjour, je suis <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-purple-400">Mokaere</span>
		</h1>

		<p class="text-xl text-gray-300 max-w-2xl mx-auto text-center">
			Un développeur passionné par la création d'applications web performantes,
			élégantes et centrées sur l'utilisateur.
		</p>

		<!-- Badges technos -->
		<TechnoBadges />

		<!-- Liens sociaux -->
		<SocialLinks />

		<!-- Lien projets -->
		<div class="mt-4">
			<a href="/projects" class="text-sm text-gray-500 hover:text-blue-400 transition border-t border-gray-800 pt-6 inline-block">
				⚡ Voir l'avancement de mes projets →
			</a>
		</div>

	</div>
</Layout>
