---
import Layout from '../layouts/Layout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import projects from '../data/projects.json';
---
<Layout title="Mon Portfolio - Roadmaps">
	<div class="space-y-6">
		{projects.map((project) => (
			<div class="bg-gray-800/50 backdrop-blur-sm p-6 rounded-xl border border-gray-700 shadow-xl">
				<h2 class="text-2xl font-semibold text-white mb-1">{project.name}</h2>
				<p class="text-gray-400 text-sm mb-4">{project.description}</p>

				<!-- Passage des tâches du projet au component progressbar -->
				<ProgressBar tasks={project.tasks} />
			</div>
		))}
	</div>
</Layout>
