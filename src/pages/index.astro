---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Mon Portfolio - Développeur">
	<div class="text-center py-10">
		<!-- Avatar/Photo -->
		<div class="w-32 h-32 bg-linear-to-r from-blue-500 to-purple-500 rounded-full mx-auto mb-6 flex items-center justify-center text-5xl font-bold text-white shadow-xl">
			👨‍💻
		</div>

		<h1 class="text-5xl font-extrabold mb-4">
			Bonjour, je suis <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-purple-400">[Ton Nom]</span>
		</h1>

		<p class="text-xl text-gray-300 max-w-2xl mx-auto mb-6">
			Développeur passionné par la création d'applications web performantes,
			élégantes et centrées sur l'utilisateur.
		</p>

		<!-- Liste des technos (badges) -->
		<div class="flex flex-wrap justify-center gap-2 mb-8">
			<span class="bg-gray-800 px-4 py-2 rounded-full text-sm border border-gray-700">⚛️ React</span>
			<span class="bg-gray-800 px-4 py-2 rounded-full text-sm border border-gray-700">🟢 Node.js</span>
			<span class="bg-gray-800 px-4 py-2 rounded-full text-sm border border-gray-700">🐍 Python</span>
			<span class="bg-gray-800 px-4 py-2 rounded-full text-sm border border-gray-700">☕ Java</span>
			<span class="bg-gray-800 px-4 py-2 rounded-full text-sm border border-gray-700">🐘 PostgreSQL</span>
		</div>

		<!-- Bouton vers les projets -->
		<a href="/projects" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-full transition shadow-lg shadow-blue-600/20">
			Voir mes projets →
		</a>
	</div>
</Layout>
